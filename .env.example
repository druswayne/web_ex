# Секрет сессий Flask
SECRET_KEY=replace-with-long-random-string

# SQLite (по умолчанию) или PostgreSQL:
# DATABASE_URL=sqlite:///instance/math9.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/math9

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_NAME=Администратор

# Необязательный демо-ученик при первом запуске
DEMO_SEED=1
DEMO_USERNAME=ivan
DEMO_PASSWORD=ivan123
DEMO_NAME=Иван Петров
DEMO_LEVEL=3-4

# OpenRouter / OpenAI-compatible vision (проверка практики)
# Можно оставить пустым — тогда ключ возьмётся из .env корня проекта
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:5000
OPENROUTER_APP_TITLE=grade9-math
AI_MODEL=openai/gpt-5.6-luna-pro
# Think для проверки: high / medium / low / off (у Luna Pro — reasoning.effort)
AI_REASONING_EFFORT=high
# AI_CHECK_MAX_TOKENS=4096
# AI_CHECK_TIMEOUT=240

# Каталог материалов (по умолчанию web/content)
# GRADE9_ROADMAP_DIR=
